# Copy this file to .env and fill in the values. .env is git-ignored.
# Never paste these keys into a chat.

# Anthropic API key (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=

# Apollo API key (Apollo -> Settings -> Integrations -> API) - used in phase 2
APOLLO_API_KEY=

# Contact email sent in the User-Agent header to job boards (polite scraping)
CONTACT_EMAIL=

# Optional: override log level (DEBUG, INFO, WARNING)
# JOBAGENT_LOG_LEVEL=INFO
